meta {
  name: Créer un token ADS
  type: http
  seq: 1
  tags: [
    ecriture
  ]
}

post {
  url: {{baseUrl}}/api/alpha/ads/token/
  body: json
  auth: none
}

headers {
  Authorization: Token {{superuserToken}}
}

body:json {
  [
    {
      "username": "prenom.nom@collectivite.fr",
      "email": "prenom.nom@collectivite.fr",
      "organization_name": "Nom de la collectivité",
      "organization_managed_cities": ["38185"]
    }
  ]
}

assert {
  res.status: eq 200
  res.body.created_users[0].token: isNotEmpty
}

docs {
  Remplacer le corps avant chaque envoi, sans l'enregistrer : aucune donnée de demandeur dans le
  dépôt. Le token est dans `created_users[0].token`.

  Avant l'envoi :

  1. Le compte ne doit pas exister : l'appel désactiverait son mot de passe et remplacerait son
     organisation.
  2. Si l'organisation existe déjà, ses communes ne changent pas : les codes envoyés sont ignorés.
}
