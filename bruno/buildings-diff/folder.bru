meta {
  name: buildings-diff
}

script:pre-request {
  // The endpoint rejects any "since" older than 6 months, so a hardcoded date would
  // eventually break. "since" is recomputed on every run instead. Widen the window
  // if the local data you want to see is older than this.
  const WINDOW_DAYS = 30;
  const since = new Date(Date.now() - WINDOW_DAYS * 24 * 60 * 60 * 1000).toISOString();
  bru.setVar("since", since);
}

script:post-response {
  // Display helper only: prints the CSV returned by /buildings/diff/ as an aligned
  // table in the Bruno console. It never touches res.body, so the Raw/Pretty tabs keep
  // showing the exact response sent by the server.

  const MAX_PRINTED_ROWS = 50;
  const MAX_COL_WIDTH = 40;

  const contentType = res.getHeader("content-type") || "";
  const body = res.getBody();

  if (typeof body === "string" && contentType.includes("text/csv")) {
    // Minimal RFC 4180 line parser: handles quoted fields containing commas and
    // doubled quotes (e.g. the sys_period range).
    function parseCsvLine(line) {
      const cells = [];
      let cur = "";
      let inQuotes = false;
      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (inQuotes) {
          if (c === '"') {
            if (line[i + 1] === '"') {
              cur += '"';
              i++;
            } else {
              inQuotes = false;
            }
          } else {
            cur += c;
          }
        } else if (c === '"') {
          inQuotes = true;
        } else if (c === ",") {
          cells.push(cur);
          cur = "";
        } else {
          cur += c;
        }
      }
      cells.push(cur);
      return cells;
    }

    const lines = body.split("\n").filter((l) => l.length > 0);

    if (lines.length > 0) {
      const totalDataRows = lines.length - 1;
      // header + at most MAX_PRINTED_ROWS data rows: a diff can hold thousands of rows
      const rows = lines.slice(0, MAX_PRINTED_ROWS + 1).map(parseCsvLine);
      const widths = rows[0].map((_, col) =>
        Math.min(
          MAX_COL_WIDTH,
          Math.max(...rows.map((r) => (r[col] || "").length))
        )
      );
      const truncate = (s, w) => (s.length > w ? s.slice(0, w - 1) + "…" : s);
      const pad = (s, w) => truncate(s, w).padEnd(w);

      console.log("");
      console.log(
        `CSV diff (console display only): ${totalDataRows} data row(s), ${rows.length - 1} printed`
      );
      rows.forEach((r, idx) => {
        console.log(r.map((cell, col) => pad(cell || "", widths[col])).join(" | "));
        if (idx === 0) {
          console.log(widths.map((w) => "-".repeat(w)).join("-+-"));
        }
      });
      console.log("");
    }
  }
}
