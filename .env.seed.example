# Configuration of the local database seed (python manage.py seed_local_db).
# Every value can be overridden on the command line, and is asked
# interactively when missing.

# Zone centers, as "lat,lon", separated by ";"
SEED_POINTS=48.8584,2.2945
# Radius around each point, in km (max 10)
SEED_RADIUS_KM=1
# Source database, typically the sandbox. Seen from the web container: to reach
# an SSH tunnel opened on your machine, use host.docker.internal as the host.
SEED_SOURCE_DSN=
