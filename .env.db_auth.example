# Configuration detail
# Those parameters can be kept as they are for a local dev version.
# They will be used both for db creation and db connections

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host port the db container is exposed on. Falls back to 5432 if unset.
# Only used by `docker compose --env-file ./.env.db_auth.dev up -d`.
DB_EXPOSED_PORT=5432
